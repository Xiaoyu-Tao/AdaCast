{
  "schema_version": 1,
  "task": {
    "dataset_path": "../../dataset/ETTh1.csv",
    "time_col": "date",
    "target_col": "OT",
    "frequency": "h",
    "strict_frequency": true,
    "seq_len": 96,
    "label_len": 48,
    "pred_len": 96,
    "forecast_gap": 0,
    "window_stride": 96,
    "split_mode": "ratio",
    "train_ratio": 0.6,
    "val_ratio": 0.2,
    "test_ratio": 0.2,
    "eval_metrics": ["mse", "mae", "wape", "mase"],
    "model_families": ["DLinear"],
    "reflection_enabled": false
  },
  "execution": {
    "mode": "deterministic",
    "max_experiments": 1
  },
  "decisions": {
    "adjustment": {"strategy": "off"}
  },
  "memory": {"enabled": false}
}
