{
  "name": "adacast-lite",
  "version": "0.3.0",
  "description": "Independent, resumable forecasting agents for fixed tasks",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": ">=1.3.11"
  },
  "bin": {
    "adacast-lite": "bin/adacast-lite"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test --timeout 240000",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "check:independence": "bun scripts/check-independence.ts",
    "schemas": "bun scripts/schemas.ts",
    "test:release": "bun scripts/smoke-release.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.8.2"
  }
}
